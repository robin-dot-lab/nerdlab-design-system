{
  "name": "nerdlab",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @robin-dot-lab/docs storybook",
    "fetch:test-fonts": "node tools/test-fonts/fetch.mjs",
    "new:component": "node tools/new-component/new-component.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "playwright-core": "^1.63.0",
    "turbo": "^2.11.6"
  },
  "license": "MIT"
}
