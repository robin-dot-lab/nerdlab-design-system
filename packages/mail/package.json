  "keywords": [
    "nerdlab",
    "design-system",
    "react",
    "email",
    "react-aria"
  ],
  "license": "MIT",
  "author": "Nerdlab",
  "homepage": "https://robin-dot-lab.github.io/nerdlab-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robin-dot-lab/nerdlab-design-system.git",
    "directory": "packages/mail"
  },
  "bugs": {
    "url": "https://github.com/robin-dot-lab/nerdlab-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
