{
  "name": "@robin-dot-lab/icons",
  "version": "0.1.0",
  "description": "Nerdlab icons: inline SVG React components drawn with 2px strokes in currentColor, sized by the nl-icon skin classes",
  "keywords": [
    "nerdlab",
    "design-system",
    "react",
    "icons",
    "svg"
  ],
  "license": "MIT",
  "author": "Nerdlab",
  "homepage": "https://robin-dot-lab.github.io/nerdlab-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robin-dot-lab/nerdlab-design-system.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/robin-dot-lab/nerdlab-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
