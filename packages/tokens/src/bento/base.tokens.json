{
  "ink": {
    "$value": "#16201B",
    "$type": "color",
    "$description": "Darkest text and the primary button. Bento never draws outlines with it."
  },
  "cream": {
    "$value": "#FFFFFF",
    "$type": "color",
    "$description": "Light text on forest, coral and ink fills; the email frame and QR code background."
  },
  "color": {
    "primary": {
      "$value": "#2E5641",
      "$type": "color",
      "$description": "Forest. Brand tiles and fills; carries white text (text-on-primary) in both themes."
    },
    "primary-hover": {
      "$value": "#24463A",
      "$type": "color"
    },
    "primary-soft": {
      "$value": "#DCE8E0",
      "$type": "color",
      "$description": "Forest tint: hover and selected backgrounds."
    },
    "secondary": {
      "$value": "#F3EFA0",
      "$type": "color",
      "$description": "Butter. Tiles, the highlighted code, the marker; text-primary on it."
    },
    "secondary-hover": {
      "$value": "#EBE586",
      "$type": "color"
    },
    "secondary-soft": {
      "$value": "#F8F6D3",
      "$type": "color",
      "$description": "Butter tint: table heads, selected rows."
    },
    "accent": {
      "$value": "#F48B2A",
      "$type": "color",
      "$description": "Orange accent: the call to action. Always ink text (white is 2.45:1)."
    },
    "accent-hover": {
      "$value": "#E77B17",
      "$type": "color"
    },
    "tomato": {
      "$value": "#C8392F",
      "$type": "color",
      "$description": "Coral red: destructive actions and failure badges. White text (5.1:1); ΔE 20 from the orange."
    },
    "lavender": {
      "$value": "#DCD6FB",
      "$type": "color",
      "$description": "Lilac tone; text-primary on it."
    },
    "violet": {
      "$value": "#4B3FA0",
      "$type": "color",
      "$description": "Deep lilac: links and strokes."
    },
    "mint": {
      "$value": "#D3E9DB",
      "$type": "color",
      "$description": "Sage: success-like tone (paid, copied); text-primary on it."
    },
    "forest": {
      "$value": "#2E5641",
      "$type": "color"
    },
    "background": {
      "$value": "#ECEEEA",
      "$type": "color",
      "$description": "Grey-green page background: tiles sit on it."
    },
    "background-grid": {
      "$value": "#E6E9E4",
      "$type": "color"
    },
    "grid-line": {
      "$value": "#D8DDD8",
      "$type": "color"
    },
    "surface": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "surface-elevated": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "surface-sunken": {
      "$value": "#F1F3EF",
      "$type": "color",
      "$description": "Wells inside a tile: quiet buttons, code, tracks."
    },
    "line": {
      "$value": "{ink}",
      "$type": "color",
      "$description": "Strokes and the focus ring."
    },
    "border": {
      "$value": "#7A847E",
      "$type": "color",
      "$description": "Form control boundary: 3:1 on the background and surfaces (WCAG 1.4.11). Tiles and buttons have no border."
    },
    "border-subtle": {
      "$value": "#DCE0DB",
      "$type": "color",
      "$description": "Hairline separators (list rows, table rows)."
    },
    "text-primary": {
      "$value": "#16201B",
      "$type": "color"
    },
    "text-secondary": {
      "$value": "#55605A",
      "$type": "color"
    },
    "text-on-primary": {
      "$value": "{cream}",
      "$type": "color"
    },
    "text-on-dark": {
      "$value": "{cream}",
      "$type": "color"
    },
    "success": {
      "$value": "#3DAA6E",
      "$type": "color"
    },
    "warning": {
      "$value": "#E9B23C",
      "$type": "color"
    },
    "error": {
      "$value": "#F0857A",
      "$type": "color",
      "$description": "Error fills with ink text."
    },
    "error-text": {
      "$value": "#B42318",
      "$type": "color"
    },
    "overlay": {
      "$value": "rgba(22, 32, 27, 0.45)",
      "$type": "color"
    },
    "info": {
      "$value": "#A397F0",
      "$type": "color"
    }
  },
  "pixel": {
    "moss": {
      "$value": "#5E9C7A",
      "$type": "color",
