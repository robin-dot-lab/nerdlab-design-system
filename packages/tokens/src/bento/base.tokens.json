    "fluid-xl": {
      "$value": "clamp(2rem, 1.3333rem + 3.3333vw, 4rem)",
      "$type": "dimension"
    },
    "gutter": {
      "$value": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)",
      "$type": "dimension"
    }
  },
  "grid": {
    "cell": {
      "$value": "24px"
    },
    "paper": {
      "$value": "{color.surface-sunken}",
      "$description": "No grid paper in Bento: a flat sunken fill."
    }
  },
