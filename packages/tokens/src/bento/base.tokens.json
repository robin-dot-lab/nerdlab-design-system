  "font": {
    "display": {
      "$value": "'Outfit', 'Outfit Fallback', system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "Titles and large numbers, 600 and 700, tight tracking."
    },
    "body": {
      "$value": "'Manrope', 'Manrope Fallback', system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "Text and interface, 400 to 700."
    },
    "mono": {
      "$value": "'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, monospace",
      "$type": "fontFamily"
    },
    "pixel": {
      "$value": "{font.mono}",
      "$type": "fontFamily",
      "$description": "Bento has no pixel face: the mono face stands in."
    }
  },
  "text": {
    "xs": {
      "$value": "0.75rem",
      "$type": "dimension"
