    "none": {
      "$value": "0",
      "$type": "dimension"
    },
    "sm": {
      "$value": "12px",
      "$type": "dimension"
    },
    "md": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "Inner elements."
    },
    "lg": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Inner elements, cards."
    },
    "xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Tiles."
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "border": {
    "width": {
      "$value": "1.5px",
      "$description": "Form control boundary."
    },
    "thick": {
      "$value": "2px",
      "$description": "Focus ring."
    },
    "hairline": {
      "$value": "1px"
    },
    "DEFAULT": {
      "$value": "{border.width} solid {color.border}",
      "$description": "Form controls only: tiles and buttons have none."
    },
    "heavy": {
      "$value": "{border.thick} solid {color.line}"
    }
  },
  "shadow": {
    "sm": {
      "$value": "none",
      "$type": "shadow",
      "$description": "Bento has no hard shadows."
    },
    "md": {
      "$value": "none",
      "$type": "shadow"
    },
    "lg": {
      "$value": "none",
      "$type": "shadow"
    },
    "soft": {
      "$value": "0 24px 48px -20px rgba(22, 32, 27, 0.28), 0 2px 8px rgba(22, 32, 27, 0.06)",
      "$type": "shadow",
      "$description": "Only what floats: dialog, menu, popover, tooltip, toast, drawer."
    },
    "glow": {
      "$value": "0 0 0 6px {color.surface}",
      "$type": "shadow",
      "$description": "Halo under the focus ring, so the ring keeps its contrast on any tone."
    }
  },
  "transition": {
    "default": {
      "$value": "background-color 0.2s ease, box-shadow 0.2s ease",
      "$type": "transition"
    },
    "slow": {
      "$value": "all 0.4s cubic-bezier(.2, .8, .2, 1)",
      "$type": "transition"
    }
  }
}
