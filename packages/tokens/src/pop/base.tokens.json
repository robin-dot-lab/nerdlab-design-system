{
  "ink": {
    "$value": "#1B1525",
    "$type": "color",
    "$description": "Universal outline, hard shadow and main text color. The backbone of the system."
  },
  "cream": {
    "$value": "#FBF3E8",
    "$type": "color"
  },
  "color": {
    "primary": {
      "$value": "#FF4FA3",
      "$type": "color",
      "$description": "Main brand / CTA / key interactive elements. Always paired with ink text + ink outline."
    },
    "primary-hover": {
      "$value": "#FF2E8E",
      "$type": "color",
      "$description": "Hover state for primary"
    },
    "primary-soft": {
      "$value": "#FFD3E8",
      "$type": "color",
      "$description": "Tinted primary backgrounds, selected rows, highlight marker"
    },
    "secondary": {
      "$value": "#6BB3E0",
      "$type": "color",
      "$description": "Supporting actions, secondary buttons, sky panels"
    },
    "secondary-hover": {
      "$value": "#4FA0D6",
      "$type": "color",
      "$description": "Hover state for secondary"
    },
    "secondary-soft": {
      "$value": "#D6ECF8",
      "$type": "color",
      "$description": "Info panels, chat bubbles"
    },
    "accent": {
      "$value": "#FFE14D",
      "$type": "color",
      "$description": "Highlights, starbursts, badges, 'new' stickers, title bars"
    },
    "accent-hover": {
      "$value": "#FFD60A",
      "$type": "color",
      "$description": "Hover state for accent"
    },
    "tomato": {
      "$value": "#FF6B35",
      "$type": "color",
      "$description": "Secondary accent: hearts, urgent stickers, search bars, price tags"
    },
    "lavender": {
      "$value": "#C9A7F5",
      "$type": "color",
      "$description": "Calm feature panels, workshop/learning contexts"
    },
    "violet": {
      "$value": "#7B4DFF",
      "$type": "color",
      "$description": "Bento hero tile, focus ring, links on dark backgrounds"
    },
    "mint": {
      "$value": "#9BE3A6",
      "$type": "color",
      "$description": "Positive panels, tags"
    },
    "forest": {
      "$value": "#1E5A3C",
      "$type": "color",
      "$description": "Deep green tile backgrounds (with mint/cream text)"
    },
    "background": {
      "$value": "#FBF3E8",
      "$type": "color",
      "$description": "Page background (cream paper)"
    },
    "background-grid": {
      "$value": "#F6DDD3",
      "$type": "color",
      "$description": "Blush grid-paper hero sections"
    },
    "grid-line": {
      "$value": "#E4BFB2",
      "$type": "color",
      "$description": "Grid paper lines (24px cell)"
    },
    "surface": {
      "$value": "#FFFDF8",
      "$type": "color",
      "$description": "Card / window body background"
    },
    "surface-elevated": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Modal / dropdown / popover background"
    },
    "surface-sunken": {
      "$value": "#F1E7DA",
      "$type": "color",
      "$description": "Wells, code blocks, disabled inputs"
    },
    "line": {
      "$value": "{ink}",
      "$type": "color"
    },
    "border": {
      "$value": "{color.line}",
      "$type": "color",
      "$description": "Dividers, input borders, card outlines (always ink, never grey)"
    },
    "border-subtle": {
      "$value": "#D9CBBB",
      "$type": "color",
      "$description": "Inner separators inside a component only"
    },
    "text-primary": {
      "$value": "#1B1525",
      "$type": "color",
      "$description": "Main body text"
    },
    "text-secondary": {
      "$value": "#5B5266",
      "$type": "color",
      "$description": "Captions, labels, placeholders"
    },
    "text-on-primary": {
      "$value": "{ink}",
      "$type": "color",
      "$description": "Text on primary/secondary/accent backgrounds (ink — not white)"
    },
    "text-on-dark": {
      "$value": "{cream}",
      "$type": "color",
      "$description": "Text on ink / forest / violet tiles"
    },
    "success": {
      "$value": "#2DBE6C",
      "$type": "color",
      "$description": "Positive states (with ink text)"
    },
    "warning": {
      "$value": "#FFB020",
      "$type": "color",
      "$description": "Caution states (with ink text)"
    },
    "error": {
      "$value": "#FF4D3D",
      "$type": "color",
      "$description": "Error states, destructive actions (with ink text)"
    },
    "info": {
      "$value": "#6BB3E0",
      "$type": "color",
      "$description": "Informational states (with ink text)"
    }
  },
  "pixel": {
    "moss": {
      "$value": "#7C9A5A",
      "$type": "color",
      "$description": "Pixel mode: nature, success"
    },
    "bark": {
      "$value": "#5C4A3B",
      "$type": "color",
      "$description": "Pixel mode: text, outlines (replaces ink)"
    },
    "pumpkin": {
      "$value": "#E3812B",
      "$type": "color",
      "$description": "Pixel mode: CTA"
    },
    "sand": {
      "$value": "#E9E1D2",
      "$type": "color",
      "$description": "Pixel mode: background"
    },
    "leaf": {
      "$value": "#C9D77A",
      "$type": "color",
      "$description": "Pixel mode: highlights"
    }
  },
  "chart": {
    "1": {
      "$value": "#7B4DFF",
      "$type": "color"
    },
    "2": {
      "$value": "#FF4FA3",
      "$type": "color"
    },
    "3": {
      "$value": "#2E9BD6",
      "$type": "color"
    },
    "4": {
      "$value": "#FF6B35",
      "$type": "color"
    },
    "seq-1": {
      "$value": "#F592C0",
      "$type": "color"
    },
    "seq-2": {
      "$value": "#F5639F",
      "$type": "color"
    },
    "seq-3": {
      "$value": "#D9347F",
      "$type": "color"
    },
    "seq-4": {
      "$value": "#A81A5E",
      "$type": "color"
    },
    "seq-5": {
      "$value": "#6E0F3D",
      "$type": "color"
    },
    "grid": {
      "$value": "#E8DCCD",
      "$type": "color"
    },
    "muted": {
      "$value": "#CBBFB0",
      "$type": "color"
    }
  },
  "font": {
    "display": {
      "$value": "'Bricolage Grotesque', 'Arial Black', system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "'Outfit', system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "'Space Mono', ui-monospace, monospace",
      "$type": "fontFamily"
    },
    "pixel": {
      "$value": "'Silkscreen', monospace",
      "$type": "fontFamily"
    }
  },
  "text": {
    "xs": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$description": "Fine print, badges, mono eyebrows"
    },
    "sm": {
      "$value": "0.875rem",
      "$type": "dimension",
      "$description": "Captions, labels, pills"
    },
    "base": {
      "$value": "1rem",
      "$type": "dimension",
      "$description": "Body text"
    },
    "lg": {
      "$value": "clamp(1.0625rem, 1.0417rem + 0.1042vw, 1.125rem)",
      "$type": "dimension",
      "$description": "Lead text, card titles"
    },
    "xl": {
      "$value": "clamp(1.25rem, 1.2083rem + 0.2083vw, 1.375rem)",
      "$type": "dimension",
      "$description": "Section sub-headers"
    },
    "2xl": {
      "$value": "clamp(1.5rem, 1.4167rem + 0.4167vw, 1.75rem)",
      "$type": "dimension",
      "$description": "Card display titles"
    },
    "3xl": {
      "$value": "clamp(2rem, 1.8333rem + 0.8333vw, 2.5rem)",
      "$type": "dimension",
      "$description": "Section titles"
    },
    "4xl": {
      "$value": "clamp(2.5rem, 2.1667rem + 1.6667vw, 3.5rem)",
      "$type": "dimension",
      "$description": "Page headers"
    },
    "5xl": {
      "$value": "clamp(3.25rem, 2.6667rem + 2.9167vw, 5rem)",
      "$type": "dimension",
      "$description": "Hero titles"
    },
    "6xl": {
      "$value": "clamp(4rem, 2.8333rem + 5.8333vw, 7.5rem)",
      "$type": "dimension",
      "$description": "Poster display (one per page max)"
    }
  },
  "leading": {
    "xs": {
      "$value": "1rem",
      "$type": "number"
    },
    "sm": {
      "$value": "1.25rem",
      "$type": "number"
    },
    "base": {
      "$value": "1.5rem",
      "$type": "number"
    },
    "lg": {
      "$value": "1.55",
      "$type": "number"
    },
    "xl": {
      "$value": "1.3",
      "$type": "number"
    },
    "2xl": {
      "$value": "1.15",
      "$type": "number"
    },
    "3xl": {
      "$value": "1.05",
      "$type": "number"
    },
    "4xl": {
      "$value": "0.95",
      "$type": "number"
    },
    "5xl": {
      "$value": "0.9",
      "$type": "number"
    },
    "6xl": {
      "$value": "0.87",
      "$type": "number"
    }
  },
  "weight": {
    "normal": {
      "$value": "400",
      "$type": "fontWeight"
    },
    "medium": {
      "$value": "500",
      "$type": "fontWeight"
    },
    "semibold": {
      "$value": "600",
      "$type": "fontWeight"
    },
    "bold": {
      "$value": "700",
      "$type": "fontWeight"
    },
    "black": {
      "$value": "800",
      "$type": "fontWeight"
    }
  },
  "tracking": {
    "display": {
      "$value": "-0.03em",
      "$type": "dimension"
    },
    "mono": {
      "$value": "0.08em",
      "$type": "dimension"
    }
  },
  "space": {
    "0": {
      "$value": "0",
      "$type": "dimension"
    },
    "1": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "2": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "3": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "4": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "5": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "6": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "8": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "10": {
      "$value": "2.5rem",
      "$type": "dimension"
    },
    "12": {
      "$value": "3rem",
      "$type": "dimension"
    },
    "16": {
      "$value": "4rem",
      "$type": "dimension"
    },
    "20": {
      "$value": "5rem",
      "$type": "dimension"
    },
    "fluid-xs": {
      "$value": "clamp(0.5rem, 0.4167rem + 0.4167vw, 0.75rem)",
      "$type": "dimension"
    },
    "fluid-sm": {
      "$value": "clamp(0.75rem, 0.5833rem + 0.8333vw, 1.25rem)",
      "$type": "dimension"
    },
    "fluid-md": {
      "$value": "clamp(1rem, 0.8333rem + 0.8333vw, 1.5rem)",
      "$type": "dimension"
    },
    "fluid-lg": {
      "$value": "clamp(1.5rem, 1.1667rem + 1.6667vw, 2.5rem)",
      "$type": "dimension"
    },
    "fluid-xl": {
      "$value": "clamp(2rem, 1.3333rem + 3.3333vw, 4rem)",
      "$type": "dimension"
    },
    "gutter": {
      "$value": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)",
      "$type": "dimension"
    }
  },
  "grid": {
    "cell": {
      "$value": "24px"
    },
    "paper": {
      "$value": "linear-gradient({color.grid-line} 1px, transparent 1px) 0 0 / {grid.cell} {grid.cell}, linear-gradient(90deg, {color.grid-line} 1px, transparent 1px) 0 0 / {grid.cell} {grid.cell}, {color.background-grid}"
    }
  },
  "section": {
    "y": {
      "$value": "clamp(3rem, 2.3333rem + 3.3333vw, 5rem)"
    }
  },
  "touch": {
    "target": {
      "$value": "44px"
    }
  },
  "nav": {
    "offset": {
      "$value": "64px"
    }
  },
  "content": {
    "max": {
      "$value": "1200px"
    }
  },
  "radius": {
    "none": {
      "$value": "0",
      "$type": "dimension"
    },
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "20px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "28px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "border": {
    "width": {
      "$value": "2px"
    },
    "thick": {
      "$value": "3px"
    },
    "hairline": {
      "$value": "1px"
    },
    "DEFAULT": {
      "$value": "{border.width} solid {color.line}"
    },
    "heavy": {
      "$value": "{border.thick} solid {color.line}"
    }
  },
  "shadow": {
    "sm": {
      "$value": "2px 2px 0 0 {color.line}",
      "$type": "shadow",
      "$description": "Hard offset — badges, small pills, inputs"
    },
    "md": {
      "$value": "4px 4px 0 0 {color.line}",
      "$type": "shadow",
      "$description": "Hard offset — buttons, cards, windows"
    },
    "lg": {
      "$value": "8px 8px 0 0 {color.line}",
      "$type": "shadow",
      "$description": "Hard offset — modals, hero windows, poster cards"
    },
    "soft": {
      "$value": "0 12px 32px -12px rgba(27, 21, 37, 0.35)",
      "$type": "shadow",
      "$description": "Bento tiles only (photographic, no outline)"
    },
    "glow": {
      "$value": "0 0 0 4px {color.primary-soft}",
      "$type": "shadow",
      "$description": "Focus halo around primary elements"
    }
  },
  "transition": {
    "default": {
      "$value": "transform 0.12s ease, box-shadow 0.12s ease, background-color 0.2s ease",
      "$type": "transition"
    },
    "slow": {
      "$value": "all 0.4s cubic-bezier(.2, .8, .2, 1)",
      "$type": "transition"
    }
  }
}
