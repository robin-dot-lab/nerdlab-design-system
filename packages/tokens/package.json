{
  "name": "@robin-dot-lab/tokens",
  "version": "1.0.0-rc.0",
  "description": "Nerdlab design tokens (DTCG source) compiled by Style Dictionary",
  "keywords": [
    "nerdlab",
    "design-system",
    "design-tokens",
    "dtcg",
    "style-dictionary"
  ],
  "license": "MIT",
  "author": "Nerdlab",
  "homepage": "https://robin-dot-lab.github.io/nerdlab-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robin-dot-lab/nerdlab-design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/robin-dot-lab/nerdlab-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./candy.css": "./dist/candy/tokens.css",
    "./candy": {
      "types": "./dist/candy/tokens.d.ts",
      "default": "./dist/candy/tokens.js"
    },
    "./candy.json": "./dist/candy/tokens.json",
    "./palettes.json": "./dist/candy/palettes.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/check-parity.mjs && node scripts/check-contrast.mjs && node ../../tools/api-surface/check.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
