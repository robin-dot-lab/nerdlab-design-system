{
  "name": "@nerdlab/tokens",
  "version": "0.1.0",
  "description": "Nerdlab design tokens (DTCG source) compiled by Style Dictionary",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
