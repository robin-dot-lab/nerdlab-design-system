    }
  },
  "typography": {
    "font-display": {
      "family": "Antonio",
      "fallback": "'Arial Narrow', sans-serif",
      "source": "https://fonts.google.com/specimen/Antonio",
      "usage": "Ultra-condensed headlines. Weight 200 for heroes, 300 for section titles. Uppercase for heroes, Title Case for section heads. Substitute for the proprietary 'Rules Gothic Condensed'."
    },
    "font-body": {
      "family": "Geist",
      "fallback": "system-ui, sans-serif",
      "source": "https://fonts.google.com/specimen/Geist",
      "usage": "Body, UI. Substitute for 'Rules'."
    },
    "font-mono": {
      "family": "Geist Mono",
      "fallback": "ui-monospace, monospace",
      "source": "https://fonts.google.com/specimen/Geist+Mono",
      "usage": "Meta labels (uppercase, 11px, +0.08em), buttons, terminal, numbers in tables. Substitute for 'Aeonik Fono'."
    },
    "scale": {
      "xs": {
        "size": "0.75rem",
        "lineHeight": "1rem",
        "usage": "Meta labels, buttons, eyebrows (mono uppercase)",
        "note": "Raised from 11px to 12px for mobile legibility"
      },
      "sm": {
        "size": "0.8125rem",
        "lineHeight": "1.25rem",
        "usage": "Captions, table cells, card body"
      },
      "base": {
        "size": "1rem (mobile) → 0.9375rem (≥1024px)",
        "lineHeight": "1.5rem",
        "usage": "Body text"
      },
      "lg": {
        "size": "clamp(1.0625rem, 1.0417rem + 0.1042vw, 1.125rem)",
        "lineHeight": "1.75rem",
        "usage": "Lead",
        "fluid": "320px → 1280px"
      },
      "xl": {
        "size": "clamp(1.375rem, 1.25rem + 0.625vw, 1.75rem)",
        "lineHeight": "1.9rem",
        "usage": "Card titles (display 300)",
        "fluid": "320px → 1280px"
      },
      "2xl": {
        "size": "clamp(1.75rem, 1.5rem + 1.25vw, 2.5rem)",
        "lineHeight": "2.6rem",
        "usage": "Sub-section titles (display 300)",
        "fluid": "320px → 1280px"
      },
      "3xl": {
        "size": "clamp(2.5rem, 2rem + 2.5vw, 4rem)",
        "lineHeight": "4rem",
        "usage": "Section titles (display 300)",
        "fluid": "320px → 1280px"
      },
      "4xl": {
        "size": "clamp(3.25rem, 2.3333rem + 4.5833vw, 6rem)",
        "lineHeight": "5.4rem",
        "usage": "Band headlines (display 200)",
        "fluid": "320px → 1280px"
      },
      "5xl": {
        "size": "clamp(4rem, 2.3333rem + 8.3333vw, 9rem)",
        "lineHeight": "7.9rem",
        "usage": "Hero (display 200)",
        "fluid": "320px → 1280px"
      },
      "6xl": {
        "size": "clamp(4.5rem, 2rem + 12.5vw, 12rem)",
        "lineHeight": "10.2rem",
        "usage": "Poster hero, one per page",
        "fluid": "320px → 1280px"
      }
    },
    "weights": {
      "thin": 200,
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 600
    },
    "tracking": {
      "display": "-0.01em",
      "normal": "0",
      "mono": "0.08em"
    }
  },
  "spacing": {
    "base-unit": "4px",
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "32": "8rem"
    },
    "content-max": "1240px"
  },
  "borders": {
    "radius": {
      "none": "0",
      "sm": "2px",
      "md": "0",
      "lg": "0",
      "xl": "0",
      "full": "9999px"
    },
    "radius-note": "Square everything. 2px only on tiny chips; full only for the 6px status dot.",
    "width": {
      "hairline": "1px",
      "default": "1px",
      "thick": "2px"
    }
  },
  "shadows": {
    "sm": {
      "value": "none",
      "usage": "No drop shadows on flat UI"
    },
    "md": {
      "value": "none",
      "usage": "Elevation is expressed by hairlines and inversion"
    },
    "lg": {
      "value": "0 24px 64px -24px rgba(0, 0, 242, 0.45)",
      "usage": "Only floating layers: terminal window, modal, tooltip"
    },
    "glow": {
      "value": "0 0 0 3px #E3E4FF",
      "usage": "Focus halo"
    }
  },
  "effects": {
    "backdrop-blur": null,
    "dither": "1-bit ordered (Bayer 4×4) dithering in ultramarine on white, or white on ultramarine. Generated on <canvas> or via halftone radial-gradient.",
    "halftone": "radial-gradient(circle, currentColor 35%, transparent 36%) 0 0 / 4px 4px",
    "scanlines": "repeating-linear-gradient(0deg, transparent 0 2px, rgba(255,255,255,.08) 2px 3px)",
    "transition-default": "background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease",
    "transition-slow": "all 0.4s cubic-bezier(.2,.8,.2,1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "primary",
        "text": "text-on-primary",
        "radius": "none",
        "height": "32px",
        "padding": "0 spacing.3",
        "font": "font-mono xs uppercase medium"
      },
      "secondary": {
        "bg": "secondary",
        "text": "ultramarine",
        "radius": "none"
      },
      "outline": {
        "bg": "transparent",
        "text": "ultramarine",
        "border": "1px solid border"
      },
      "ghost": {
        "bg": "transparent",
        "text": "ultramarine",
        "hover": "underline"
      },
      "invert": {
        "bg": "#FFFFFF",
        "text": "ultramarine",
        "usage": "Primary CTA inside .nl-invert sections"
      }
    },
    "window": {
      "bg": "surface",
      "border": "1px solid border-subtle",
      "radius": "none",
      "bar": {
        "height": "32px",
        "font": "font-mono xs uppercase",
        "controls": "12px square hairline boxes"
      }
    },
    "terminal": {
      "bg": "terminal-bg",
      "radius": "8px (only rounded element — it is an OS window)",
      "dots": [
        "#FF5F57",
        "#FEBC2E",
        "#28C840"
      ],
      "font": "font-mono sm",
      "shadow": "lg"
    },
    "card": {
      "bg": "surface",
      "border": "1px solid border-subtle",
      "radius": "none",
      "padding": "spacing.6",
      "shadow": "none"
    },
    "feature": {
      "label": "#N + mono xs uppercase",
      "title": "display 300 xl",
      "body": "sm",
      "media": "square dithered image"
    },
    "input": {
      "bg": "surface",
      "border": "1px solid border",
      "radius": "none",
      "height": "40px",
      "focus-ring": "glow"
    },
    "tag": {
      "border": "1px solid border",
      "radius": "none",
      "font": "font-mono xs uppercase"
    },
    "accordion": {
      "rule": "1px solid border",
      "question": "display 300 xl",
      "icon": "+ / −"
    }
  },
  "responsive": {
    "strategy": "Mobile-first. Base styles target small screens; enhance with min-width media queries for page layout and container queries for components.",
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px",
      "note": "Content-driven; CSS custom properties can't be used in @media, so these values are the contract."
    },
    "fluid-spacing": {
      "space-fluid-xs": "clamp(0.5rem, 0.4167rem + 0.4167vw, 0.75rem)",
      "space-fluid-sm": "clamp(0.75rem, 0.5833rem + 0.8333vw, 1.25rem)",
      "space-fluid-md": "clamp(1rem, 0.8333rem + 0.8333vw, 1.5rem)",
      "space-fluid-lg": "clamp(1.5rem, 1.1667rem + 1.6667vw, 2.5rem)",
      "space-fluid-xl": "clamp(2rem, 1.3333rem + 3.3333vw, 4rem)",
      "space-gutter": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)",
      "section-y": "clamp(3.5rem, 2.6667rem + 4.1667vw, 6rem)",
      "usage": "Fluid tokens for layout (gutters, section rhythm, grid gaps). Component internals keep the fixed 4px scale."
    },
    "touch-target": {
      "value": "44px",
      "usage": "Min height/width of interactive elements on (pointer: coarse)"
    },
    "containers": {
      "auto": ".nl-card, .nl-window, .nl-bento, .nl-cq, .nl-table-wrap are inline-size containers",
      "examples": [
        "KPI numbers: font-size clamp(1.75rem, 15cqi, 2.5rem)",
        ".nl-info stacks below 22rem",
        ".nl-table--stack turns rows into cards below 40rem",
        "Dashboard grids query .main (container 'main'), not the viewport"
      ]
    },
    "primitives": [
      ".nl-container",
      ".nl-section",
      ".nl-stack",
      ".nl-cluster",
      ".nl-grid-auto (--grid-min)",
      ".nl-split (--split, lg+)",
      ".nl-full-height (100dvh)",
      ".nl-scroll-x"
    ],
    "navigation": ".nl-nav-toggle + .nl-nav-panel (below lg); toggled with aria-expanded / data-open, closes on Escape, link click, and when crossing lg",
    "viewport-units": "Use dvh/svh with a vh fallback, never bare 100vh",
    "logical-properties": "margin/padding/border use inline/block (margin-inline-start, border-block-end…)"
  }
}