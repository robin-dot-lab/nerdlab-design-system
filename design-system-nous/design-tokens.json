{
  "meta": {
    "name": "Nerdlab Ultramarine",
    "description": "Monochrome ultramarine editorial: one electric blue on cool paper, ultra-condensed thin display type, hairlines, square corners, dithered imagery.",
    "version": "2.0.0",
    "created": "2026-10-02",
    "basedOn": "Nerdlab Pop v1.0.0 (same component API, new skin)",
    "personality": "A research-lab broadsheet printed in a single ink. Everything is one electric ultramarine on cool grey paper — text, rules, buttons, images. Giant hairline-thin condensed headlines do the shouting; tiny uppercase mono labels do the annotating. Imagery is 1-bit dithered and halftoned, never photographic color. Sections flip to full-bleed blue with white ink for emphasis.",
    "references": [
      "https://nousresearch.com/ — giant thin condensed headline, blue/grey paper, blue band sections with dithered art, alternating text/image rows",
      "https://hermes-agent.nousresearch.com/ — full-blue inverted hero, terminal window, square small buttons, numbered feature grid, hairline FAQ accordion"
    ]
  },
  "colors": {
    "ultramarine": {
      "value": "#0000F2",
      "usage": "THE ink. Text, rules, buttons, icons, dithered images. Also full-bleed inverted section background."
    },
    "primary": {
      "value": "#0000F2",
      "usage": "Primary CTA fill, links, focus"
    },
    "primary-hover": {
      "value": "#0000C4",
      "usage": "Hover state for primary"
    },
    "primary-soft": {
      "value": "#E3E4FF",
      "usage": "Selected rows, hover wash, tint backgrounds"
    },
    "secondary": {
      "value": "#E4E4EC",
      "usage": "Secondary button fill (blue text on it, 7.3:1)"
    },
    "secondary-hover": {
      "value": "#D6D6E4",
      "usage": "Hover state for secondary"
    },
    "accent": {
      "value": "#0000F2",
      "usage": "There is no second accent hue in UI chrome. Emphasis = inversion (blue bg, white ink), not a new color."
    },
    "glitch-magenta": {
      "value": "#D61F8C",
      "usage": "Rare glitch accent: 2-4px scanline strips at image edges. Never for text or buttons."
    },
    "glitch-cyan": {
      "value": "#0090D0",
      "usage": "Rare glitch accent, paired with magenta"
    },
    "background": {
      "value": "#F2F2F2",
      "usage": "Page background (cool paper)"
    },
    "surface": {
      "value": "#FFFFFF",
      "usage": "Cards, inputs, table body"
    },
    "surface-elevated": {
      "value": "#FFFFFF",
      "usage": "Popovers, tooltips (with hairline + soft blue shadow)"
    },
    "surface-sunken": {
      "value": "#E8E8EE",
      "usage": "Wells, disabled fields, code"
    },
    "invert-bg": {
      "value": "#0000F2",
      "usage": "Full-bleed emphasis sections (.nl-invert)"
    },
    "invert-text": {
      "value": "#FFFFFF",
      "usage": "Text on invert-bg (9.2:1)"
    },
    "invert-muted": {
      "value": "#C9CCFF",
      "usage": "Secondary text on invert-bg (5.9:1)"
    },
    "terminal-bg": {
      "value": "#0B0B12",
      "usage": "Terminal window body"
    },
    "terminal-text": {
      "value": "#E8E8F0",
      "usage": "Terminal text"
    },
    "border": {
      "value": "#0000F2",
      "usage": "Structural hairlines (1px). Rules between sections, input borders, table header rule."
    },
    "border-subtle": {
      "value": "#C9CBF2",
      "usage": "Inner separators, card outlines, table rows"
    },
    "text-primary": {
      "value": "#0000F2",
      "usage": "Body and headings — text is blue, not black (8.2:1 on paper)"
    },
    "text-secondary": {
      "value": "#5050C8",
      "usage": "Captions, meta, placeholders (5.7:1)"
    },
    "text-on-primary": {
      "value": "#FFFFFF",
      "usage": "Text on blue fills"
    },
    "success": {
      "value": "#087A4D",
      "usage": "Positive states (white text, 5.4:1)"
    },
    "warning": {
      "value": "#9E5C00",
      "usage": "Caution states (white text)"
    },
    "error": {
      "value": "#C8202F",
      "usage": "Errors, destructive (white text, 5.7:1)"
    },
    "info": {
      "value": "#0000F2",
      "usage": "Informational = the brand blue"
    },
    "dark": {
